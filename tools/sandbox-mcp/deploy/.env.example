# 复制为 .env 并填写凭据
# ---- 沙箱 MCP ----
# DEEIX 管理后台注册该服务时使用的 Bearer Token（必须）
SANDBOX_MCP_API_KEY=change-me-sandbox-key
# 会话容器基础镜像（VPS 上先构建 tools/sandbox-mcp/docker/base.Dockerfile）
SANDBOX_BASE_IMAGE=deeix-sandbox-base:latest
# 会话闲置回收时间（秒），默认 900
SANDBOX_LEASE_TTL_SEC=900
# 命令默认/最大超时（秒）
SANDBOX_EXEC_TIMEOUT_SEC=120
SANDBOX_MAX_EXEC_TIMEOUT_SEC=600
# 沙箱与 mm 多模态工具共享卷（沙箱 /shared/<scope> 文件可被 mm 工具读取）
SANDBOX_SHARED_VOLUME=deeix-mcp-shared
# 每会话容器资源限额
SANDBOX_MEMORY_LIMIT=1g
SANDBOX_PIDS_LIMIT=256
SANDBOX_CPUS_LIMIT=0.5

# ---- Qwen-MM-Plugins（阿里云百炼，必须）----
DASHSCOPE_API_KEY=sk-xxxxxxxx
# 可选：自定义 OpenAI 兼容网关（如 AxonHub 代理百炼）
DASHSCOPE_BASE_URL=
# 工具响应体上限（字节），DEEIX 后端响应上限 8MiB，保守取 6MiB
QWEN_MM_MAX_RESPONSE_BYTES=6291456
QWEN_MM_CHAT_TIMEOUT=600
# 可选：启用 core 的 web_search/web_extractor/image_search（serper.dev 免费档）
SERPER_API_KEY=
