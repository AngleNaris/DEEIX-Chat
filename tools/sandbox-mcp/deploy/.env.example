# 复制为 .env 并填写凭据
# ---- 沙箱 MCP ----
# DEEIX 管理后台注册该服务时使用的 Bearer Token（必须）
SANDBOX_MCP_API_KEY=change-me-sandbox-key
# 会话容器基础镜像（VPS 上先构建 tools/sandbox-mcp/docker/base.Dockerfile）
SANDBOX_BASE_IMAGE=deeix-sandbox-base:latest
# 会话闲置回收时间（秒），默认 900
SANDBOX_LEASE_TTL_SEC=900
# 命令默认/最大超时（秒）
SANDBOX_EXEC_TIMEOUT_SEC=120
SANDBOX_MAX_EXEC_TIMEOUT_SEC=600
# 共享目录宿主路径（沙箱只 bind 挂载自己 scope 子目录；后端与 mm 网关挂载整目录只读）
SANDBOX_SHARED_HOST_DIR=/opt/deeix-mcp/shared
# 导入目录：后端按 scope 放入的文件，沙箱以 /imports 只读看到
SANDBOX_IMPORTS_HOST_DIR=/opt/deeix-mcp/imports
SANDBOX_IMPORTS_DIR=/imports
# 会话容器内共享目录挂载点（默认 /shared，一般无需改）
SANDBOX_SHARED_DIR=/shared
# _meta 身份签名密钥（与后端环境变量 SANDBOX_META_HMAC_KEY 一致；为空回退用 API Key 派生）
SANDBOX_META_HMAC_KEY=change-me-meta-key
# 下载工具出站白名单（默认空 = 拒绝全部私网/回环目标，SSRF 防护）
SANDBOX_ALLOWED_HOSTS=
SANDBOX_ALLOWED_CIDRS=
# 会话容器专用网络；先按 deploy/setup-sandbox-egress.sh 创建并加固，禁止加入 1panel-network
SANDBOX_NETWORK_MODE=deeix-sandbox-egress
# 每会话容器资源限额
SANDBOX_MEMORY_LIMIT=1g
SANDBOX_PIDS_LIMIT=256
SANDBOX_CPUS_LIMIT=0.5

# staging 目录只供 wrapper 与 MM upstream 使用，不要放在 shared 目录下
MM_STAGING_HOST_DIR=/opt/deeix-mcp/mm-staging
MM_IMPORTS_HOST_DIR=/opt/deeix-mcp/imports
DASHSCOPE_API_KEY=sk-xxxxxxxx
# 可选：自定义 OpenAI 兼容网关（如 AxonHub 代理百炼）
DASHSCOPE_BASE_URL=
# 工具响应体上限（字节），DEEIX 后端响应上限 8MiB，保守取 6MiB
QWEN_MM_MAX_RESPONSE_BYTES=6291456
QWEN_MM_CHAT_TIMEOUT=600
# 可选：启用 core 的 web_search/web_extractor/image_search（serper.dev 免费档）
SERPER_API_KEY=
